# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yourAnonKey
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yourServiceRoleKey
SUPABASE_STORAGE_BUCKET=crop-diagnostics

# Optional: Supabase Direct Database Connection for Migration Runner
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Google Gemini AI Configuration (Server-Side Only - Never expose to frontend)
GEMINI_API_KEY=AIzaSyYourSecretKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Weather Integration (Open-Meteo is supported out-of-the-box with 0 keys; optional provider keys below)
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_IMAGE_SIZE_MB=10

